# Home Assistant MQTT Agent Configuration
# Copy this file to config.yaml and update with your settings

mqtt:
  broker: "192.168.1.100"  # Your MQTT broker IP address
  port: 1883
  username: "your_mqtt_username"  # Optional
  password: "your_mqtt_password"  # Optional
  client_id: "hass_pc_agent"

homeassistant:
  discovery_prefix: "homeassistant"
  device_name: "Gaming PC"
  device_id: "gaming_pc_01"

agent:
  # How often to update status (in seconds)
  status_update_interval: 30

  # Predefined commands that can be executed
  # Format: command_name: "command to execute"
  custom_commands:
    # Windows examples:
    # open_steam: "C:\\Program Files (x86)\\Steam\\steam.exe"
    # close_all_browsers: "taskkill /F /IM chrome.exe /IM firefox.exe /IM msedge.exe"

    # Linux examples:
    # open_firefox: "firefox"
    # screenshot: "gnome-screenshot"

  # List of folders where games are installed
  # The agent will scan these folders for executables and detect when they're running
  # Supports environment variables like %PROGRAMFILES% (Windows) or $HOME (Linux)
  game_folders:
    # Windows examples:
    # - "C:\\Program Files (x86)\\Steam\\steamapps\\common"
    # - "C:\\Program Files\\Epic Games"
    # - "C:\\XboxGames"
    # - "%PROGRAMFILES(X86)%\\Steam\\steamapps\\common"
    # - "D:\\SteamLibrary\\steamapps\\common"

    # Linux examples:
    # - "$HOME/.steam/steam/steamapps/common"
    # - "$HOME/.local/share/Steam/steamapps/common"
    # - "$HOME/Games"
    # - "/usr/games"
    # - "~/.wine/drive_c/Program Files/Steam/steamapps/common"


